# Set locally. Never commit real values. Lookup/cancel require only login credentials.
EPOST_USERNAME=
EPOST_PASSWORD=
# Reserve requires all four card fields (strings, without separators).
EPOST_CARD_NUMBER=
# MMYY
EPOST_CARD_EXPIRY=
# First two digits, not the full card password
EPOST_CARD_PASSWORD_PREFIX=
# Six-digit birth date or ten-digit business registration number
EPOST_CARD_IDENTITY=
EPOST_JOURNAL_PATH=.epost/operations.sqlite
# Optional: use an existing Chromium/Chrome executable
# EPOST_BROWSER_PATH=
